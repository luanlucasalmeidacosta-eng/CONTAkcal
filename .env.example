# Server-side only (read by /api functions, never exposed to the client bundle)
GEMINI_API_KEY=
# Opcionais: modelo principal e reservas do Google (lista separada por vírgula).
# Padrão: gemini-3.6-flash, depois gemma-4-31b-it, gemma-4-26b-a4b-it (gratuitos,
# mesma chave), gemini-3.8-flash e gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemma-4-31b-it,gemma-4-26b-a4b-it,gemini-3.8-flash,gemini-3.5-flash-lite
# Opcional: Groq, gratuito sem cartão (console.groq.com/keys). Com a chave,
# ele vira o primeiro da fila; AI_PRIMARY_PROVIDER=google o deixa por último.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# AI_PRIMARY_PROVIDER=groq
